<RCC>
    <!-- The Markdown preview (markdown_page.cpp): its page from page/ and the pinned
         markdown-it, KaTeX, Mermaid and MathJax builds CMakeLists.txt downloads.
         Generated into the build directory by configure_file(); edit this template. -->
    <qresource prefix="/neko/markdown">
        <file alias="preview.html">@NEKO_MARKDOWN_PAGE_DIR@/preview.html</file>
        <file alias="preview.css">@NEKO_MARKDOWN_PAGE_DIR@/preview.css</file>
        <file alias="preview.js">@NEKO_MARKDOWN_PAGE_DIR@/preview.js</file>
        <file alias="vendor/markdown-it.min.js">@NEKO_MARKDOWN_IT_JS@</file>
        <file alias="vendor/markdown-it-sub.min.js">@NEKO_MARKDOWN_IT_SUB_JS@</file>
        <file alias="vendor/markdown-it-sup.min.js">@NEKO_MARKDOWN_IT_SUP_JS@</file>
        <file alias="vendor/markdown-it-footnote.min.js">@NEKO_MARKDOWN_IT_FOOTNOTE_JS@</file>
        <file alias="vendor/markdown-it-deflist.min.js">@NEKO_MARKDOWN_IT_DEFLIST_JS@</file>
        <file alias="vendor/markdown-it-emoji.min.js">@NEKO_MARKDOWN_IT_EMOJI_JS@</file>
        <file alias="vendor/katex.min.js">@NEKO_KATEX_JS@</file>
        <file alias="vendor/mermaid.min.js">@NEKO_MERMAID_JS@</file>
        <file alias="vendor/tex-svg.js">@NEKO_MATHJAX_JS@</file>
    </qresource>
</RCC>
