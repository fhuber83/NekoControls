        <file alias="neko_markdown_editor_bar.qm">../../../translations/neko_markdown_editor_bar.qm</file>
        <file alias="neko_markdown_editor_it.qm">../../../translations/neko_markdown_editor_it.qm</file>
    </qresource>
</RCC>
