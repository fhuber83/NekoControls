        <file alias="neko_editor_de.qm">../../../translations/neko_editor_de.qm</file>
        <file alias="neko_editor_bar.qm">../../../translations/neko_editor_bar.qm</file>
        <file alias="neko_editor_it.qm">../../../translations/neko_editor_it.qm</file>
    </qresource>
</RCC>
