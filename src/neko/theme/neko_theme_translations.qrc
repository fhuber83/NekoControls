        <file alias="neko_theme_de.qm">../../../translations/neko_theme_de.qm</file>
        <file alias="neko_theme_bar.qm">../../../translations/neko_theme_bar.qm</file>
        <file alias="neko_theme_it.qm">../../../translations/neko_theme_it.qm</file>
    </qresource>
</RCC>
